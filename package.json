{
	"name": "@toreda/log",
	"version": "1.0.0",
	"description": "Lightweight TypeScript logger with flexible custom transports.",
	"main": "./dist/index.js",
	"module": "./dist/esm/index.js",
	"typings": "./dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"make:docs": "typedoc docs --categorizeByGroup false --entryPoints ./src/index.ts",
		"test": "jest --coverage --maxWorkers=50%",
		"test:fast": "jest --coverage=false --maxWorkers=50%",
		"test:ci": "jest --ci --coverage --maxWorkers=50% --silent --verbose=false",
		"test:silent": "jest --coverage=false --maxWorkers=50% --silent --verbose=false",
		"build": "pnpm run build:prod",
		"build:prod": "gulp --prod",
		"build:dev": "gulp --dev",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toreda/log.git"
	},
	"keywords": [
		"lightweight",
		"logger",
		"logging",
		"serverless",
		"toreda",
		"typescript",
		"transport"
	],
	"author": "Toreda, Inc.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toreda/log/issues"
	},
	"homepage": "https://github.com/toreda/log#readme",
	"devDependencies": {
		"@jest/types": "^30.5.1",
		"@swc/core": "^1.16.2",
		"@swc/jest": "^0.2.39",
		"@swc/register": "^0.1.10",
		"@toreda/eslint-config": "^3.1.0",
		"@toreda/prettier-config": "^1.0.1",
		"@types/eslint": "^9.6.1",
		"@types/gulp": "^4.0.10",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.2",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@typescript-eslint/typescript-estree": "^8.70.0",
		"canvas": "^3.2.3",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-prettier": "^5.5.6",
		"gulp": "^4.0.2",
		"gulp-typescript": "^6.0.0-alpha.1",
		"jest": "^30.5.1",
		"jest-cli": "^30.5.1",
		"jest-environment-jsdom": "^30.5.1",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.9.5",
		"typedoc": "^0.24.6",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=18"
	},
	"prettier": "@toreda/prettier-config",
	"dependencies": {
		"@toreda/shared-types": "^3.0.0"
	}
}
